      "fields": {
        "response_format": "json"
      },
      "lang": {
        "field": "language",
        "format": "iso"
      },
      "text": "/text",
      "featured": true,
      "live": {
        "docs": "https://developers.openai.com/api/docs/guides/realtime-transcription",
        "models": [
          "gpt-live-transcribe",
          "gpt-transcribe"
        ],
        "default_model": "gpt-live-transcribe",
        "url": "wss://api.openai.com/v1/realtime?intent=transcription",
        "browser": {
          "token": {
            "url": "https://api.openai.com/v1/realtime/client_secrets",
            "body": "{\"expires_after\":{\"anchor\":\"created_at\",\"seconds\":60},\"session\":{\"type\":\"transcription\",\"audio\":{\"input\":{\"format\":{\"type\":\"audio/pcm\",\"rate\":24000},\"transcription\":{\"model\":\"{model}\"},\"turn_detection\":null}}}}",
            "text": "/value"
          },
          "protocols": [
            "realtime",
            "openai-insecure-api-key.{token}"
          ]
        },
        "lang": {
          "format": "iso"
        },
        "start": "{\"type\":\"session.update\",\"session\":{\"type\":\"transcription\",\"audio\":{\"input\":{\"format\":{\"type\":\"audio/pcm\",\"rate\":24000},\"transcription\":{\"model\":\"{model}\",\"language\":\"{lang}\"},\"turn_detection\":null}}}}",
        "start_auto": "{\"type\":\"session.update\",\"session\":{\"type\":\"transcription\",\"audio\":{\"input\":{\"format\":{\"type\":\"audio/pcm\",\"rate\":24000},\"transcription\":{\"model\":\"{model}\"},\"turn_detection\":null}}}}",
        "rate": 24000,
        "audio": "{\"type\":\"input_audio_buffer.append\",\"audio\":\"{audio}\"}",
        "messages": [
          {
            "match": {
              "/type": "conversation.item.input_audio_transcription.delta"
            },
            "do": "delta",
            "text": "/delta"
          },
          {
            "match": {
              "/type": "conversation.item.input_audio_transcription.completed"
            },
            "do": "final",
            "text": "/transcript"
          },
          {
            "match": {
              "/type": "error"
            },
            "do": "error",
            "text": "/error/message"
          }
        ],
        "join": " ",
        "end": "{\"type\":\"input_audio_buffer.commit\"}",
        "end_done": "final",
        "max_seconds": 3600,
        "experimental": true,
        "notes": "No server turn detection for gpt-live-transcribe: the whole dictation is one turn, committed when you stop; words stream as deltas.",
        "map": {
          "gpt-transcribe": "gpt-live-transcribe"
        }
      }
    },

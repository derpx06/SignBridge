<resources>
    <!-- Accessibility service (replaces accessibility_description in the service config) -->
    <string name="accessibility_description_v2">Voicio shows a small microphone bubble next to the text field you are typing in and puts the words you dictate into that field. It only looks at the field you are typing in, never at password fields, and it does not tap, swipe, read the rest of the screen or take screenshots. Your voice stays on this phone unless you turn on a cloud provider. To switch Voicio off quickly (for example before paying), use the Voicio tile in Quick Settings, or use the Voicio Keyboard, which needs no accessibility access.</string>

    <!-- Pause -->
    <string name="tile_label">Voicio</string>
    <string name="tile_on">On · tap to pause</string>
    <string name="tile_paused">Paused · tap to turn on</string>
    <string name="tile_on_description">Voicio bubble is on. Tap to pause it completely.</string>
    <string name="tile_paused_description">Voicio bubble is paused. Tap to open its setting and turn it back on.</string>
    <string name="pause_action">Pause Voicio</string>
    <string name="pause_explain">Turns Voicio\'s accessibility off completely, so banking and payment apps stop warning. Turn it back on with the Voicio tile or in Settings › Accessibility › Voicio.</string>
    <string name="turn_back_on">Turn back on</string>
    <string name="turn_back_on_explain">Android lets only you switch accessibility on. Tap Voicio, then the switch.</string>


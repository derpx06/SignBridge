<?xml version="1.0" encoding="utf-8"?>
<!-- The orange core breathes once while Android shows the splash. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:drawable="@drawable/splash_icon">
    <target android:name="core">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="450" android:valueFrom="1" android:valueTo="1.22" android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="scaleY" android:duration="450" android:valueFrom="1" android:valueTo="1.22" android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="scaleX" android:startOffset="450" android:duration="450" android:valueFrom="1.22" android:valueTo="1" android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="scaleY" android:startOffset="450" android:duration="450" android:valueFrom="1.22" android:valueTo="1" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
